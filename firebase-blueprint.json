{
  "entities": {
    "PublicProfile": {
      "title": "PublicProfile",
      "description": "Public creator profile visible across SnapTop feeds, search, and profiles without PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "minLength": 2,
          "maxLength": 30,
          "pattern": "^[a-zA-Z0-9_.]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "bio": {
          "type": "string",
          "minLength": 0,
          "maxLength": 240
        },
        "avatarUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 150000
        },
        "website": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200
        },
        "followersCount": {
          "type": "number"
        },
        "followingCount": {
          "type": "number"
        },
        "postsCount": {
          "type": "number"
        },
        "isPublic": {
          "type": "boolean"
        },
        "isVerified": {
          "type": "boolean",
          "description": "Whether the user has been manually verified."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "username",
        "displayName",
        "bio",
        "avatarUrl",
        "website",
        "followersCount",
        "followingCount",
        "postsCount",
        "isPublic",
        "createdAt",
        "updatedAt"
      ]
    },
    "PrivateUser": {
