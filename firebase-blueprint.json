  },
  "firestore": {
    "/publicProfiles/{userId}": {
      "schema": { "$ref": "#/entities/PublicProfile" },
      "description": "Public creator profiles without PII."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/PrivateUser" },
      "description": "Private user PII and preferences strictly owned by the user."
    },
    "/posts/{postId}": {
      "schema": { "$ref": "#/entities/Post" },
      "description": "Public posts and vertical reels."
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/Comment" },
      "description": "Comments under a Firestore post."
    },
    "/postLikes/{likeId}": {
      "schema": { "$ref": "#/entities/PostLike" },
      "description": "Like records keyed by postId_userId."
    },
    "/savedPosts/{saveId}": {
      "schema": { "$ref": "#/entities/SavedPost" },
      "description": "Bookmarked posts keyed by userId_postId."
    },
    "/stories/{storyId}": {
      "schema": { "$ref": "#/entities/Story" },
      "description": "Public creator stories."
    },
    "/follows/{followId}": {
      "schema": { "$ref": "#/entities/Follow" },
      "description": "Follow graph edges keyed by followerId_followingId."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "User activity notifications."
    },
    "/conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "1-on-1 direct message threads."
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Real-time direct messages inside a thread."
    },
    "/mediaFiles/{mediaId}": {
      "schema": { "$ref": "#/entities/MediaFile" },
      "description": "Chunked media file metadata."
    },
    "/mediaFiles/{mediaId}/chunks/{chunkId}": {
      "schema": { "$ref": "#/entities/MediaChunk" },
      "description": "Media payload chunks for fast video playback."
    },
    "/notes/{userId}": {
      "schema": { "$ref": "#/entities/Note" },
      "description": "Short public status notes displayed in Profile and Messages."
    }
  }
}
